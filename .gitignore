*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
build/
dist/
.eggs/

# 运行数据（演示项目、缓存、日志、导出）
workspace/

# 内部压力测试与标定数据：含本机路径、日志和大量中间数组，不随源码发布
stress/
stress_calibration*/
stress_calibration_scale/

# 本地配置与凭据
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*
secrets*
*token*.json
*secret*.json

# 日志与临时文件
*.log
*.tmp
*.temp
*.bak
*.swp
*~

# 编辑器与操作系统
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# 数据与打包产物
*.zip
*.7z
*.tar
*.tar.gz
*.npy
*.npz
*.pkl
*.joblib
*.h5
*.hdf5
*.tif
*.tiff

# 示例：保留紧凑回放数据和结果，原始影像/解压目录/临时工作区仍忽略
!examples/*/data/*.npy
!examples/*/results/*.npy
!examples/*/results/*.tif
examples/*/source/
examples/*/workspace/

# 本地发布目录
release/
