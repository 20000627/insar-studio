# InSAR Studio 环境变量示例
#
# 用法：
#   1. 复制本文件为 .env；
#   2. 按需修改；
#   3. 在启动前把变量导入当前 shell。
#
# 注意：程序不会自动读取 .env。Windows PowerShell 可用：
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^\s*([^#][^=]*)=(.*)$') {
#       [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process')
#     }
#   }
# 然后运行 python -m insar_studio serve --open。
# 也可以直接在“系统属性 → 环境变量”里设置。
#
# 不要把真实的 .env 提交到 Git；.gitignore 已忽略 .env 和 .env.*。

# 工作区根目录。留空时使用 <repo>/workspace。
INSAR_STUDIO_WORKSPACE=

# 以下变量只对直接调用 server.main() 生效；
# 使用 python -m insar_studio serve 时，请改用 --host / --port 参数。
INSAR_STUDIO_HOST=127.0.0.1
INSAR_STUDIO_PORT=8765

# 调试模式会返回 traceback，仅限本机排查问题。
INSAR_STUDIO_DEBUG=0

# 启动后自动打开浏览器；等价于 --open。
INSAR_STUDIO_OPEN=0

# 端口被占用时直接失败；否则从起始端口向后尝试。
INSAR_STUDIO_STRICT_PORT=0

# GACOS 的邮箱和令牌不在这里配置。
# 它们只在单次任务中使用，程序不会写入项目元数据或报告。
